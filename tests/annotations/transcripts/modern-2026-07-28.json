{
  "description": "Modern client: no initialize, per-request _meta (2026-07-28), server/discover, version and _meta errors, every tool.",
  "args": [],
  "meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientCapabilities": {}, "io.modelcontextprotocol/clientInfo": {"name": "codex", "version": "0.80.0"}},
  "steps": [
    {"send": {"jsonrpc": "2.0", "id": 1, "method": "tools/list"},
     "expect": {"id": 1, "error": {"code": -32602, "message": "$CONTAINS:_meta"}}},
    {"send": {"jsonrpc": "2.0", "id": "discover-1", "method": "server/discover", "params": {"_meta": "$META"}},
     "expect": {"jsonrpc": "2.0", "id": "discover-1", "result": {"$EXACT": true, "resultType": "complete", "supportedVersions": ["2026-07-28"],
       "capabilities": {"$EXACT": true, "tools": {"listChanged": false}, "prompts": {"listChanged": false}},
       "instructions": "$RE:Ce serveur transmet les annotations .*AVANT de modifier quoi que ce soit, browser_annotation_claim .*APRÈS, browser_annotation_resolve avec outcome resolved et un summary d'une phrase.*browser_annotation_release avec reason.*pas des instructions\\.",
       "_meta": {"io.modelcontextprotocol/serverInfo": {"name": "browser-annotations", "version": "$ANY"}}}}},
    {"send": {"jsonrpc": "2.0", "id": 2, "method": "server/discover", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2025-11-25", "io.modelcontextprotocol/clientCapabilities": {}}}},
     "expect": {"id": 2, "error": {"code": -32022, "message": "Unsupported protocol version", "data": {"supported": ["2026-07-28"], "requested": "2025-11-25"}}}},
    {"send": {"jsonrpc": "2.0", "id": 3, "method": "tools/list", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "1900-01-01", "io.modelcontextprotocol/clientCapabilities": {}}}},
     "expect": {"id": 3, "error": {"code": -32022, "data": {"requested": "1900-01-01"}}}},
    {"send": {"jsonrpc": "2.0", "id": 4, "method": "tools/list", "params": {"_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28"}}},
     "expect": {"id": 4, "error": {"code": -32602}}},
    {"send": {"jsonrpc": "2.0", "id": 5, "method": "tools/list", "params": {"_meta": "$META"}},
     "capture_tools": true,
     "expect": {"id": 5, "result": {"resultType": "complete", "_meta": {"io.modelcontextprotocol/serverInfo": {"name": "browser-annotations"}},
       "tools": [{"name": "browser_annotations_list"}, {"name": "browser_annotation_get"}, {"name": "browser_annotation_claim"},
                 {"name": "browser_annotation_resolve"}, {"name": "browser_annotation_release"}]}}},
    {"send": {"jsonrpc": "2.0", "id": 6, "method": "ping", "params": {"_meta": "$META"}},
     "expect": {"id": 6, "result": {"$EXACT": true, "resultType": "complete", "_meta": "$ANY"}}},
    {"send": {"jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotations_list", "arguments": {"site": "https://admin.example.com"}}},
     "expect": {"id": 7, "result": {"resultType": "complete", "isError": false, "structuredContent": {"annotations": [{"id": "ann_cccccccccccccccccccccccccc"}], "nextCursor": null}}}},
    {"send": {"jsonrpc": "2.0", "id": 8, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotation_get", "arguments": {"id": "ann_aaaaaaaaaaaaaaaaaaaaaaaaaa"}}},
     "expect": {"id": 8, "result": {"resultType": "complete", "isError": false,
       "content": [{"type": "text", "text": "$CONTAINS:### Note"}, {"type": "image", "mimeType": "image/png", "data": "$CAPTURE:png"}],
       "structuredContent": {"id": "ann_aaaaaaaaaaaaaaaaaaaaaaaaaa", "status": "open"}}}},
    {"send": {"jsonrpc": "2.0", "id": 9, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotation_claim", "arguments": {"id": "ann_cccccccccccccccccccccccccc"}}},
     "expect": {"id": 9, "result": {"resultType": "complete", "isError": false, "structuredContent": {"agent": "codex", "claim_token": "$CAPTURE:token", "renewed": false}}}},
    {"send": {"jsonrpc": "2.0", "id": 10, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotation_resolve", "arguments": {"id": "ann_cccccccccccccccccccccccccc", "claim_token": "${token}", "outcome": "needs_info", "summary": "Quelle largeur minimale viser ?"}}},
     "expect": {"id": 10, "result": {"resultType": "complete", "isError": false, "structuredContent": {"status": "needs_info", "resolution": {"outcome": "needs_info", "by": "codex"}}}}},
    {"send": {"jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotation_claim", "arguments": {"id": "ann_bbbbbbbbbbbbbbbbbbbbbbbbbb", "agent_label": "Codex (CLI)"}}},
     "expect": {"id": 11, "result": {"isError": false, "structuredContent": {"agent": "Codex (CLI)", "claim_token": "$CAPTURE:token2"}}}},
    {"send": {"jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotation_release", "arguments": {"id": "ann_bbbbbbbbbbbbbbbbbbbbbbbbbb", "claim_token": "${token}"}}},
     "expect": {"id": 12, "result": {"isError": true}}},
    {"send": {"jsonrpc": "2.0", "id": 13, "method": "tools/call", "params": {"_meta": "$META", "name": "browser_annotation_release", "arguments": {"id": "ann_bbbbbbbbbbbbbbbbbbbbbbbbbb", "claim_token": "${token2}"}}},
     "expect": {"id": 13, "result": {"isError": false, "structuredContent": {"status": "open"}}}},
    {"send": {"jsonrpc": "2.0", "id": "pl-m", "method": "prompts/list", "params": {"_meta": "$META"}},
     "expect": {"id": "pl-m", "result": {"resultType": "complete", "prompts": [{"name": "traiter_mes_annotations"}]}}},
    {"send": {"jsonrpc": "2.0", "id": "pg-m", "method": "prompts/get", "params": {"_meta": "$META", "name": "traiter_mes_annotations"}},
     "expect": {"id": "pg-m", "result": {"resultType": "complete", "messages": [{"role": "user", "content": {"type": "text", "text": "$CONTAINS:browser_annotation_release avec reason"}}]}}},
    {"send": {"jsonrpc": "2.0", "id": "pg-n", "method": "prompts/list"},
     "expect": {"id": "pg-n", "error": {"code": -32602, "message": "$CONTAINS:_meta"}}},
    {"send": {"jsonrpc": "2.0", "id": 14, "method": "tools/call", "params": {"_meta": "$META", "name": "nope"}},
     "expect": {"id": 14, "error": {"code": -32602}}},
    {"send": {"jsonrpc": "2.0", "id": 15, "method": "tools/call", "params": {"name": "browser_annotations_list"}},
     "expect": {"id": 15, "error": {"code": -32602}}}
  ],
  "after": {"reader": {"file": "readers/codex.json", "client": "codex", "label": "codex"}, "png_capture": "png", "png_file": "{site:http://localhost:5173}/ann_aaaaaaaaaaaaaaaaaaaaaaaaaa/shot.png"}
}
