// Publisher metadata shared by every executable we ship (browser.exe, update-helper.exe,
// browser-annotations-mcp.exe). The including file defines VI_DESCRIPTION, VI_INTERNAL and
// VI_ORIGINAL first. Windows shows these strings in the file's Properties and in Task Manager,
// and antivirus heuristics distrust unsigned executables whose metadata is empty.
// tests/update-integration/run_all.py (check_app) requires every field below.
#ifndef BROWSER_FILEVERSION
#define BROWSER_FILEVERSION 0,2,0,0
#define BROWSER_VERSION_TEXT "0.2.0"
#endif
#define VI_PUBLISHER "ValXXII"

1 VERSIONINFO
 FILEVERSION BROWSER_FILEVERSION
 PRODUCTVERSION BROWSER_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", VI_PUBLISHER "\0"
   VALUE "FileDescription", VI_DESCRIPTION "\0"
   VALUE "ProductName", "browser\0"
   VALUE "InternalName", VI_INTERNAL "\0"
   VALUE "OriginalFilename", VI_ORIGINAL "\0"
   VALUE "LegalCopyright", "Copyright 2026 " VI_PUBLISHER "\0"
   VALUE "FileVersion", BROWSER_VERSION_TEXT "\0"
   VALUE "ProductVersion", BROWSER_VERSION_TEXT "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
